# Copy to .env and fill in real values. Never commit .env.
# Keep .env in the project root, never in public/ (files there are served).

# PostgreSQL connection used by Prisma (CLI and app).
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://quizflow:postgres@localhost:5432/quizflow?schema=public"

# Optional. Public origin used to build absolute links such as QR join URLs.
# APP_URL="http://localhost:3000"

# Development-only test accounts. Used by `npm run dev` and ignored in
# production builds. Usernames must be email addresses.
TEACHER_USERNAME="teacher@example.edu"
TEACHER_PASSWORD="replace-with-a-dev-password"
STUDENT_USERNAME="student@example.edu"
STUDENT_PASSWORD="replace-with-a-dev-password"

# Optional. Signs development test-account sessions (32+ characters).
# Without it a random key is generated each time the dev server starts.
# AUTH_DEV_SESSION_SECRET=""

# Optional. Base URL for Playwright when testing an already running server.
# PLAYWRIGHT_BASE_URL="http://127.0.0.1:3000"
